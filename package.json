{
  "name": "frontline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev src/local.ts",
    "test": "vitest run",
    "check": "npm run check:types && npm run check:lint && npm test",
    "check:types": "wrangler types --check --strict-vars=false && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "check:lint": "eslint --max-warnings 0 .",
    "types": "wrangler types --strict-vars=false",
    "check:screens": "node scripts/screens.js"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@eslint/js": "10.0.1",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
